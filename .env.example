# KAI-Mind local environment variables
# Copy to `.env` and fill in values. Never commit `.env` (it is gitignored).

# --- NVIDIA NIM mapping proposal provider (explicit opt-in) ---
# Hosted provider is disabled unless BOTH flags below are set.
# Without them, the proposal flow uses deterministic fallback.
KAI_MIND_ENABLE_NVIDIA_NIM_PROPOSALS=false
NVIDIA_API_KEY=""

# To enable hosted NVIDIA NIM locally:
# KAI_MIND_ENABLE_NVIDIA_NIM_PROPOSALS=true
# NVIDIA_API_KEY="nvapi-your-key-here"

# --- Optional NVIDIA NIM overrides (defaults in src/kai_mind/core/configs/llm_proposal.toml) ---
# NVIDIA_NIM_MODEL=google/gemma-4-31b-it
# NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_NIM_TIMEOUT_SECONDS=8.0
# NVIDIA_NIM_MAX_TOKENS=16384
# NVIDIA_NIM_TEMPERATURE=1.0
# NVIDIA_NIM_TOP_P=0.95
# NVIDIA_NIM_STREAM=false
# NVIDIA_NIM_ENABLE_THINKING=true
# KAI_MIND_MAPPING_PROPOSAL_PROMPT_TEMPLATE=mapping_proposal.v1.yaml
