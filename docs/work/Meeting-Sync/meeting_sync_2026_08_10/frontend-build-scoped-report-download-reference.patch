+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  MAP_REPORT_FILE_NAME,
+  MapReportError,
+  downloadMapBuildReport,
+  loadMapBuildReport,
+} from "./mapReportApi";
+
+const BASE_URL = "http://127.0.0.1:8000";
+const MARKDOWN = "# AI System Map\n\n- Build: `build:b1`\n";
+
+function markdownResponse(body = MARKDOWN) {
+  return new Response(body, {
+    status: 200,
+    headers: { "Content-Type": "text/markdown; charset=utf-8" },
+  });
+}
+
+/* The backend's 404s are the plain-string {"detail": "<code>"} form. */
+function detailResponse(detail: unknown, status = 404) {
+  return new Response(JSON.stringify({ detail }), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+function stubFetch(response: Response) {
+  const fetchMock = vi.fn().mockResolvedValue(response);
+  vi.stubGlobal("fetch", fetchMock);
+  return fetchMock;
+}
+
+/* jsdom implements neither object-URL method; the save path is their only user. */
+function stubObjectUrls(objectUrl = "blob:systograph/ai-system-map") {
+  const createObjectURL = vi.fn<(blob: Blob) => string>(() => objectUrl);
+  const revokeObjectURL = vi.fn<(url: string) => void>();
+  URL.createObjectURL = createObjectURL;
+  URL.revokeObjectURL = revokeObjectURL;
+  return { createObjectURL, revokeObjectURL, objectUrl };
+}
+
+function stubAnchorClick() {
+  const clicks: { download: string; href: string; connected: boolean }[] = [];
+  vi.spyOn(HTMLAnchorElement.prototype, "click").mockImplementation(function (
+    this: HTMLAnchorElement,
+  ) {
+    clicks.push({ download: this.download, href: this.href, connected: this.isConnected });
+  });
+  return clicks;
+}
+
+/** Lets the deferred revoke (a macrotask after the click) run. */
+function flushMacrotasks() {
+  return new Promise((resolve) => setTimeout(resolve, 0));
+}
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  Reflect.deleteProperty(URL, "createObjectURL");
+  Reflect.deleteProperty(URL, "revokeObjectURL");
+});
+
+describe("loadMapBuildReport", () => {
+  it("reads the build-scoped artifact with an encoded build id", async () => {
+    const fetchMock = stubFetch(markdownResponse());
+
+    await expect(loadMapBuildReport(BASE_URL, "build:b1")).resolves.toBe(MARKDOWN);
+
+    expect(String(fetchMock.mock.calls[0][0])).toBe(
+      "http://127.0.0.1:8000/api/map-builds/build%3Ab1/artifacts/ai_system_map.md",
+    );
+    const init = fetchMock.mock.calls[0][1] as RequestInit;
+    expect(new Headers(init.headers).get("Accept")).toBe("text/markdown");
+  });
+
+  it("never asks for the attachment variant, because it saves the bytes itself", async () => {
+    const fetchMock = stubFetch(markdownResponse());
+
+    await loadMapBuildReport(BASE_URL, "build:b1");
+
+    expect(String(fetchMock.mock.calls[0][0])).not.toContain("download");
+  });
+
+  it.each([
+    ["build_not_found"],
+    ["artifact_not_available"],
+    ["artifact_not_found"],
+  ])("classifies the %s 404 instead of leaving it a network error", async (detail) => {
+    stubFetch(detailResponse(detail));
+
+    await expect(loadMapBuildReport(BASE_URL, "build:b1")).rejects.toMatchObject({
+      name: "MapReportError",
+      reason: detail,
+      status: 404,
+    });
+  });
+
+  it("treats a 404 outside the three contract codes as unknown", async () => {
+    stubFetch(detailResponse("Not Found"));
+
+    await expect(loadMapBuildReport(BASE_URL, "build:b1")).rejects.toMatchObject({
+      name: "MapReportError",
+      reason: "unknown",
+      status: 404,
+    });
+  });
+
+  it("treats the 422 array-detail form as unknown rather than crashing on it", async () => {
+    stubFetch(detailResponse([{ loc: ["query", "download"], msg: "bool parsing failed" }], 422));
+
+    await expect(loadMapBuildReport(BASE_URL, "build:b1")).rejects.toMatchObject({
+      name: "MapReportError",
+      reason: "unknown",
+      status: 422,
+    });
+  });
+
+  it("wraps transport failures so callers only ever handle MapReportError", async () => {
+    vi.stubGlobal("fetch", vi.fn().mockRejectedValue(new TypeError("Failed to fetch")));
+
+    const error = await loadMapBuildReport(BASE_URL, "build:b1").catch((caught) => caught);
+    expect(error).toBeInstanceOf(MapReportError);
+    expect(error.reason).toBe("unknown");
+  });
+});
+
+describe("downloadMapBuildReport", () => {
+  it("saves the fetched markdown through a released object URL", async () => {
+    stubFetch(markdownResponse());
+    const { createObjectURL, revokeObjectURL, objectUrl } = stubObjectUrls();
+    const clicks = stubAnchorClick();
+
+    await downloadMapBuildReport(BASE_URL, "build:b1");
+
+    // Revoking in the click's own task can cancel the download, so the release
+    // must still be pending here and only land after the macrotask flush below.
+    expect(revokeObjectURL).not.toHaveBeenCalled();
+
+    expect(createObjectURL).toHaveBeenCalledOnce();
+    const blob = createObjectURL.mock.calls[0][0];
+    expect(blob).toBeInstanceOf(Blob);
+    expect(blob.type).toBe("text/markdown");
+    await expect(blob.text()).resolves.toBe(MARKDOWN);
+
+    // The anchor must carry the backend's whitelist name and be in the
+    // document at click time, or Firefox drops the download.
+    expect(clicks).toEqual([{ download: MAP_REPORT_FILE_NAME, href: objectUrl, connected: true }]);
+    expect(document.querySelector("a[download]")).toBeNull();
+
+    await flushMacrotasks();
+    expect(revokeObjectURL).toHaveBeenCalledWith(objectUrl);
+  });
+
+  it("reports the build-scoped 404 and never opens an object URL", async () => {
+    stubFetch(detailResponse("artifact_not_available"));
+    const { createObjectURL } = stubObjectUrls();
+    const clicks = stubAnchorClick();
+
+    await expect(downloadMapBuildReport(BASE_URL, "build:b1")).rejects.toMatchObject({
+      name: "MapReportError",
+      reason: "artifact_not_available",
+    });
+
+    expect(createObjectURL).not.toHaveBeenCalled();
+    expect(clicks).toEqual([]);
+  });
+});
diff --git a/frontend/src/services/mapReportApi.ts b/frontend/src/services/mapReportApi.ts
new file mode 100644
index 0000000..9ab6ef3
--- /dev/null
+++ b/frontend/src/services/mapReportApi.ts
@@ -0,0 +1,100 @@
+import { ApiRequestError, fetchText, normalizeBaseUrl } from "./http";
+
+/**
+ * The one entry on the backend's artifact whitelist. It is hardcoded on
+ * purpose: the frontend never derives an artifact name from user input, and
+ * the saved file must carry the same name the backend publishes.
+ */
+export const MAP_REPORT_FILE_NAME = "ai_system_map.md";
+const MAP_REPORT_MEDIA_TYPE = "text/markdown";
+
+/**
+ * The three documented 404 codes of
+ * `GET /api/map-builds/{build_id}/artifacts/{file_name}`, plus `unknown` for
+ * everything else (transport failure, timeout, a 404 outside the contract).
+ * The UI turns a reason into its own copy, so no raw error text reaches
+ * the screen.
+ */
+export type MapReportErrorReason =
+  | "build_not_found"
+  | "artifact_not_available"
+  | "artifact_not_found"
+  | "unknown";
+
+const CONTRACT_REASONS: MapReportErrorReason[] = [
+  "artifact_not_found",
+  "build_not_found",
+  "artifact_not_available",
+];
+
+export class MapReportError extends Error {
+  reason: MapReportErrorReason;
+  status?: number;
+
+  constructor(reason: MapReportErrorReason, message: string, status?: number) {
+    super(message);
+    this.name = "MapReportError";
+    this.reason = reason;
+    this.status = status;
+  }
+}
+
+/**
+ * Read one build's rendered Markdown map. The caller passes the build id it
+ * already has on screen, so an older build returns that build's report and a
+ * newer build never wins.
+ */
+export async function loadMapBuildReport(
+  baseUrl: string,
+  buildId: string,
+  signal?: AbortSignal,
+): Promise<string> {
+  const url = `${normalizeBaseUrl(baseUrl)}/api/map-builds/${encodeURIComponent(buildId)}/artifacts/${MAP_REPORT_FILE_NAME}`;
+
+  try {
+    // No `download=true`: that variant only sets Content-Disposition for a
+    // browser navigation, and this path saves the bytes itself.
+    return await fetchText(url, { signal, headers: { Accept: MAP_REPORT_MEDIA_TYPE } });
+  } catch (error) {
+    throw asMapReportError(error);
+  }
+}
+
+/**
+ * Fetch the build's report and hand it to the browser as a file. Going through
+ * fetch instead of a plain link keeps the 404 codes visible to the UI, which a
+ * navigation would swallow.
+ */
+export async function downloadMapBuildReport(
+  baseUrl: string,
+  buildId: string,
+  signal?: AbortSignal,
+): Promise<void> {
+  const markdown = await loadMapBuildReport(baseUrl, buildId, signal);
+  const objectUrl = URL.createObjectURL(new Blob([markdown], { type: MAP_REPORT_MEDIA_TYPE }));
+  const anchor = document.createElement("a");
+  anchor.href = objectUrl;
+  anchor.download = MAP_REPORT_FILE_NAME;
+  // Firefox only follows a download anchor that is in the document.
+  document.body.append(anchor);
+
+  try {
+    anchor.click();
+  } finally {
+    anchor.remove();
+    // Releasing the object URL in the same task can cancel the download the
+    // click just started; hand it back on the next one instead.
+    window.setTimeout(() => URL.revokeObjectURL(objectUrl), 0);
+  }
+}
+
+function asMapReportError(error: unknown): MapReportError {
+  if (error instanceof MapReportError) return error;
+  if (error instanceof ApiRequestError) {
+    const reason = CONTRACT_REASONS.find(
+      (candidate) => error.status === 404 && error.message === candidate,
+    );
+    return new MapReportError(reason ?? "unknown", error.message, error.status);
+  }
+  return new MapReportError("unknown", error instanceof Error ? error.message : String(error));
+}
