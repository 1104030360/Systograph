+function downloadNote(state: DownloadState): string {
+  switch (state.status) {
+    case "loading":
+      return `Reading ${MAP_REPORT_FILE_NAME} for this build…`;
+    case "done":
+      return `Saved ${MAP_REPORT_FILE_NAME} for this build.`;
+    case "error":
