+
+/**
+ * Downloads the report of one build — the pinned historical build when there is
+ * one, otherwise the loaded build. Each of the three contract 404s is settled
+ * for that build, so only an unknown failure is worth retrying.
+ */
+function BuildReportDownload({ apiBaseUrl, buildId }: { apiBaseUrl: string; buildId: string }) {
+  const [state, setState] = useState<DownloadState>({ status: "idle" });
+  const settled = state.status === "error" && state.reason !== "unknown";
+
+  async function save() {
+    setState({ status: "loading" });
+    try {
+      await downloadMapBuildReport(apiBaseUrl, buildId);
+      setState({ status: "done" });
+    } catch (error) {
+      setState({
+        status: "error",
+        reason: error instanceof MapReportError ? error.reason : "unknown",
+      });
+    }
+  }
+
+  return (
+    <div className="readiness-download">
+      <button
+        className="btn"
+        type="button"
+        onClick={() => void save()}
+        disabled={state.status === "loading" || settled}
+      >
+        <Download aria-hidden="true" size={14} />
+        {state.status === "loading" ? "Downloading…" : "Download report (.md)"}
+      </button>
+      <p className="readiness-download-note" role="status">{downloadNote(state)}</p>
+    </div>
+  );
+}
