// IT Ticket System - Entity Relationship Model
// 從需求規格文件 (demand.md) 萃取的資料模型

// ============================================================
// 核心實體：工單 (Ticket/Incident)
// ============================================================

Table Ticket {
  internalId int [primary key, increment, note: '內部自動遞增ID']
  id string [unique, not null, note: '工單編號,唯一識別碼 (例如: INC40125246)']
  text string [note: '完整案例描述,由使用者自訂欄位合併而成,預設必須包含opened欄位,合併順序與分隔符號由系統決定']
  subcategory string [note: '問題類型分類']
  configurationItem string [note: '系統模組/配置項']
  roleComponent string [note: '受影響的角色/元件']
  location string [note: '地點/區域']
  opened string [note: '工單建立時間,ISO 8601格式,統一使用UTC時區儲存']
  analysisTime string [not null, note: '分析時間戳記,ISO 8601格式,統一使用UTC時區儲存,用於增量同步依據']
  solution string [note: 'AI提取的解決方案']
  problem string [note: 'AI生成的問題摘要,≤50字']
  aiCategory string [note: 'AI細緻分類結果,比configurationItem更具體']
  severityScore float [note: '嚴重性分數,基於關鍵字/多人影響/升級處理,0-100區間,保留2位小數並四捨五入']
  frequencyScore float [note: '頻率分數,基於配置項頻率/元件角色頻率/時間群聚,0-100區間,保留2位小數並四捨五入']
  impactScore float [note: '影響分數,severityScore與frequencyScore的加權平均,0-100區間,保留2位小數並四捨五入']
  riskLevel string [note: '風險等級: 高風險/中風險/低風險/忽略']

  Note: '''
    工單實體,系統的核心資料物件。

    跨屬性不變條件:
    - impactScore = severityScore * weight_severity + frequencyScore * weight_frequency
    - 權重總和必須為1.0: weight_severity + weight_frequency = 1.0
    - 所有分數欄位範圍: 0 ≤ score ≤ 100
    - riskLevel動態決定: 若滿足聚類條件(資料量≥4 且 最大值-最小值>5.0 且 標準差>3.0,三條件皆需滿足)則使用KMeans聚類(K=4,對應四個等級),否則使用固定門檻
    - 固定門檻(左閉右開): 高風險[70,100], 中風險[50,70), 低風險[30,50), 忽略[0,30)
    - id必須唯一
    - 去重邏輯: 相同id時保留analysisTime最新的記錄
  '''

  Indexes {
    id [name: 'idx_id']
    opened [name: 'idx_opened']
    configurationItem [name: 'idx_configItem']
    analysisTime [name: 'idx_analysisTime']
  }
}

// ============================================================
// 配置實體：權重配置
// ============================================================

Table WeightConfiguration {
  id int [primary key, increment, note: '配置ID']
  keyword float [note: '高風險關鍵字權重,預設0.2']
  multi_user float [note: '多人受影響權重,預設0.15']
  escalated float [note: '升級處理權重,預設0.15']
  config_frequency float [note: '配置項頻率權重,預設0.2']
  component_frequency float [note: '元件/角色頻率權重,預設0.15']
  cluster_size float [note: '時間群聚權重,預設0.15']

  Note: '''
    風險評分權重配置實體。

    跨屬性不變條件:
    - keyword + multi_user + escalated + config_frequency + component_frequency + cluster_size = 1.0
    - 所有權重值: 0 ≤ weight ≤ 1.0 (允許極端值0或1,例如單一因素權重為1.0其餘為0)
  '''
}

// ============================================================
// 配置實體：欄位優先順序配置
// ============================================================

Table FieldPriorityConfiguration {
  id int [primary key, increment, note: '配置ID']
  field_type string [note: '欄位類型: summary_priority, resolution_priority, 或 text_priority']
  priority_order string [note: 'JSON陣列格式,儲存欄位名稱的優先順序清單']

  Note: '''
    Excel欄位讀取優先順序配置實體。
    例如: summary_priority = ["Short description", "Description"]
         resolution_priority = ["Close notes", "Work notes"]
         text_priority = ["opened", "Description", "Short description"] (預設必須包含opened)
  '''
}

// ============================================================
// 配置實體：語句資料庫
// ============================================================

Table SentenceDatabase {
  id int [primary key, increment, note: '語句ID']
  sentence_type string [note: '語句類型: high_risk, escalate, multi_user']
  sentence string [note: '語句內容']

  Note: '''
    自訂語句資料庫實體,用於風險評估語意偵測。
    - high_risk: 高風險關鍵字 (例如: fire, electrical, safety, 斷電, 當機)
    - escalate: 升級處理觸發詞
    - multi_user: 多人影響指標

    語意偵測使用 paraphrase-MiniLM-L6-v2 模型進行 embedding
    語意相似度閾值固定為0.7,不可調整(硬編碼於SmartScoring.py:137,154,171)。
  '''
}

// ============================================================
// 配置實體：GPT提示詞配置
// ============================================================

Table GPTPromptConfiguration {
  id int [primary key, increment, note: '提示詞ID']
  task_type string [unique, note: '任務類型: solution, ai_summary, ai_category']
  prompt string [note: '提示詞內容']
  model string [note: 'Ollama模型名稱 (例如: llama3.2, command-r7b:latest)']

  Note: '''
    AI模型提示詞配置實體。
    儲存路徑: gpt_data/gpt_prompt_map.json
  '''
}

// ============================================================
// 配置實體：同步路徑配置
// ============================================================

Table SyncPathConfiguration {
  id int [primary key, increment, note: '配置ID']
  path string [note: 'SharePoint/OneDrive本機同步資料夾路徑']

  Note: '''
    雲端同步路徑配置實體。
    儲存路徑: StorageAddress/SyncAddress.json
    需通過可寫入測試驗證。
  '''
}

// ============================================================
// 對話實體：聊天會話
// ============================================================

Table ChatSession {
  id string [primary key, note: '會話ID,格式: chat_YYYYMMDD_HHMMSS']
  title string [note: '會話標題,可由使用者重命名']
  timestamp string [note: '建立時間,ISO 8601格式']
  messages string [note: 'JSON格式,儲存對話訊息陣列']

  Note: '''
    RAG對話系統的會話實體。
    儲存目錄: chat_history/
    檔案格式: {id}.json

    messages結構: [
      {"role": "user", "content": "問題內容"},
      {"role": "assistant", "content": "AI回覆"}
    ]

    限制: 無大小或數量限制,單一會話可包含任意輪數對話
  '''
}

// ============================================================
// 分類記憶實體：AI分類記憶
// ============================================================

Table CategoryMemory {
  id int [primary key, increment, note: '記憶ID']
  configurationItem string [note: '配置項名稱']
  category string [note: 'AI生成的分類名稱']

  Note: '''
    AI分類記憶實體,用於保持相同配置項的分類一致性。
    儲存路徑: data/sentences/{configurationItem}_categories.json

    處理邏輯:
    - 同一配置項的新工單分類時,AI會參考此記憶中的歷史分類
    - 首次遇到新配置項時,參考其他相似配置項的歷史分類(語意相似度匹配)
  '''
}

// ============================================================
// 上傳檔案實體
// ============================================================

Table UploadedFile {
  id int [primary key, increment, note: '檔案ID']
  filename string [note: '原始檔案名稱']
  stored_filename string [note: '儲存檔案名稱,格式: result_YYYYMMDD_HHMMSS.xlsx']
  upload_time string [note: '上傳時間,ISO 8601格式']
  file_size int [note: '檔案大小(bytes),必須 ≤ 10485760 bytes']
  file_path string [note: '檔案儲存路徑: uploads/']

  Note: '''
    上傳檔案記錄實體。

    限制條件:
    - 僅接受 .xlsx 格式
    - 檔案大小 ≤ 10485760 bytes (10MiB,使用1024進位,非10MB)
    - 驗證邏輯: Analysis.py:99 設定 MAX_CONTENT_LENGTH = 10 * 1024 * 1024
  '''
}

// ============================================================
// FAISS向量索引元資料 (外部儲存,此處僅記錄結構)
// ============================================================

// FAISS索引結構說明:
// - 檔案: kb_index.faiss (FAISS索引)
// - 檔案: kb_metadata.json (元資料,與SQLite的Ticket同步)
// - 檔案: kb_texts.pkl (文本語料,Pickle格式)
// - 維度: 384 (all-MiniLM-L6-v2 embeddings)
// - 索引類型: IndexFlatL2 + IndexIDMap
// - ID映射: SHA-256(id) mod 2^63
//
// 注意: FAISS索引不是關聯式資料庫實體,而是向量檢索引擎,
// 其元資料與Ticket實體保持同步關係。
//
// 模型變更相容性處理:
// - 若未來變更embedding模型(非384維),需完整重建FAISS索引
// - 舊索引自動備份至backup/目錄(build_kb.py策略)
// - 不支援多版本索引共存或降維/升維技術

// ============================================================
// 關聯關係 (目前無明確外鍵關聯,各實體獨立)
// ============================================================

// 說明:
// 根據需求規格文件,各實體主要為獨立配置或記錄,
// 未明確定義外鍵關聯關係。
// 實體間的關聯主要透過應用層邏輯實現:
// - Ticket與CategoryMemory透過configurationItem關聯
// - Ticket與FAISS向量索引透過id欄位同步
