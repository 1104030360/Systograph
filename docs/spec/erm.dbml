// KAI-Mind Epic 1 - AI System Map data model
// 範圍：RAG System Map Builder MVP

Table RagSystemMap {
  schema_version string [pk, note: 'ai-system-map/v1']
  system_type string [not null, note: 'Epic 1 固定為 rag']
  project_name string
  project_root string [note: '僅供顯示。Evidence 應優先使用 project-relative paths。']
  selected_template string [not null, note: 'rag-core-v1']
  generated_at string
}

Table ComponentSlot {
  id string [pk]
  system_map_schema_version string [not null]
  slot string [not null, note: 'data_source, chunking, embedding_model, vector_store, retriever, llm 等']
  status string [not null, note: 'detected | missing | not_configured | not_applicable']
  required_for_rag boolean
  summary string
}

Table ComponentInstance {
  id string [pk]
  slot_id string [not null]
  name string [not null]
  kind string [not null]
  evidence_ids string [note: 'Evidence.id 的 JSON array']
}

Table Endpoint {
  id string [pk]
  system_map_schema_version string [not null]
  endpoint_type string [not null, note: 'local | external']
  value string [not null, note: '若像 secret，必須遮罩']
  source_component_id string
  evidence_ids string [note: 'Evidence.id 的 JSON array']
}

Table Evidence {
  id string [pk]
  system_map_schema_version string [not null]
  kind string [not null, note: 'file, config_key, docker_service, dependency, code_pattern, parse_error']
  file string [note: 'Project-relative POSIX path']
  path string [note: 'Config path, JSON path, YAML path 或 code symbol']
  value string [note: '敏感值必須遮罩或省略']
  line_start int
  line_end int
  parser string
  masked boolean
}

Table Flow {
  id string [pk]
  system_map_schema_version string [not null]
  name string [not null, note: 'indexing | query_answer']
  summary string
}

Table Edge {
  id string [pk]
  flow_id string [not null]
  from_slot_id string [not null]
  to_slot_id string [not null]
  relationship string [not null]
  evidence_ids string [note: 'Evidence.id 的 JSON array']
}

Table RiskHint {
  id string [pk]
  system_map_schema_version string [not null]
  target_type string [not null, note: 'component_instance | endpoint | component_slot']
  target_id string [not null]
  rule_id string [not null]
  evidence_id string [not null]
  severity_hint string [note: 'low | medium | high']
  rationale string [not null]
  uncertainty string [not null, note: '說明為什麼這只是 hint，不是最終結論']
}

Table RecommendedNextCheck {
  id string [pk]
  system_map_schema_version string [not null]
  check_type string [not null]
  target_type string
  target_id string
  rationale string
}

Ref: ComponentSlot.system_map_schema_version > RagSystemMap.schema_version
Ref: ComponentInstance.slot_id > ComponentSlot.id
Ref: Endpoint.system_map_schema_version > RagSystemMap.schema_version
Ref: Evidence.system_map_schema_version > RagSystemMap.schema_version
Ref: Flow.system_map_schema_version > RagSystemMap.schema_version
Ref: Edge.flow_id > Flow.id
Ref: Edge.from_slot_id > ComponentSlot.id
Ref: Edge.to_slot_id > ComponentSlot.id
Ref: RiskHint.system_map_schema_version > RagSystemMap.schema_version
Ref: RiskHint.evidence_id > Evidence.id
Ref: RecommendedNextCheck.system_map_schema_version > RagSystemMap.schema_version
